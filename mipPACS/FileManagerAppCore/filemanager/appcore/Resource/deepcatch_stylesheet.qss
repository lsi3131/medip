/*============  Check Box ============= */
QCheckBox#m_chkFolderOpen {
    background-color : #535353;
}

QCheckBox#m_chkFolderOpen:hover {
    background-color : #484848;
}

QCheckBox#m_chkFolderOpen::indicator {
    image: url(:/Resource/Images/deepcatch/arrow_close_d.png);
}

QCheckBox#m_chkFolderOpen::indicator:hover {
    image: url(:/Resource/Images/deepcatch/arrow_close_h.png);
}

QCheckBox#m_chkFolderOpen::indicator:checked {
    image: url(:/Resource/Images/deepcatch/arrow_open_d.png);
}

QCheckBox#m_chkFolderOpen::indicator:checked:hover {
    image: url(:/Resource/Images/deepcatch/arrow_open_h.png);
}

QCheckBox#m_chkRecentOpen {
    background-color : #535353;
}

QCheckBox#m_chkRecentOpen:hover {
    background-color : #484848;
}	

QCheckBox#m_chkRecentOpen::indicator {
    image: url(:/Resource/Images/deepcatch/arrow_close_d.png);
}

QCheckBox#m_chkRecentOpen::indicator:hover {
    image: url(:/Resource/Images/deepcatch/arrow_close_h.png);
}

QCheckBox#m_chkRecentOpen::indicator:checked {
    image: url(:/Resource/Images/deepcatch/arrow_open_d.png);
}

QCheckBox#m_chkRecentOpen::indicator:checked:hover {
    image: url(:/Resource/Images/deepcatch/arrow_open_h.png);
}

/*================ Label ===================*/
QLabel#m_labelArrow {
    image: url(:/Resource/Images/deepcatch/arrow_open_d.png);
	min-width: 24px;
	min-height: 24px;
}


QLabel#m_labelListArrowHorz {
    image: url(:/Resource/Images/deepcatch/List_arrow_horizontal.png);
	min-width: 24px;
	min-height: 24px;
}

QLabel#m_labelListArrowVert {
    image: url(:/Resource/Images/deepcatch/List_arrow_vertical.png);
	min-width: 24px;
	min-height: 24px;
}

QTextEdit {
	color: black;
	background-color : white;
	foreground-color : black;
	border-style: outset;
	border-color: rgba(48, 48, 48, 255);
}

