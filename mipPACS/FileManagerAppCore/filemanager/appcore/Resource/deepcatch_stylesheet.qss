QMainWindow#MainWindow {
	background-color: #535353;
}

QWidget {
	background-color: #535353;
}

QDialog {
	background-color: #535353;
}

QFrame#frameMenu {
	background-color: #373737;
}

QListView{
	background-color: #303030;
}

QTableView{
	background-color: #303030;
}

QTreeView{
	background-color: #303030;
}

QSpinBox{
	background-color: #303030;
}

QTabBar::tab:selected {
	background: rgba(48, 48, 48, 255); 
	color: white;
}

QTabBar::tab:!selected {
	background: rgba(82, 82, 82, 255); 
	color: white;
}

QTabWidget::pane {
	border: 1px; 
	background: rgba(48, 48, 48, 255); 
	color: black;
}

/* m_directoryTreeView */
QTreeView#m_directoryTreeView::branch:open {
    image: url(:/Resource/Images/deepcatch/folder_view_arrow_open_d.png) 0;
}

QTreeView#m_directoryTreeView::branch:open:hover {
    image: url(:/Resource/Images/deepcatch/folder_view_arrow_open_h.png) 0;
}

QTreeView#m_directoryTreeView::branch:closed:has-children {
    image: url(:/Resource/Images/deepcatch/folder_view_arrow_close_d.png) 0;
}

QTreeView#m_directoryTreeView::branch:closed:has-children:hover {
    image: url(:/Resource/Images/deepcatch/folder_view_arrow_close_h.png) 0;
}

/* m_mainFileTreeView */
QTreeView#m_mainFileTreeView::branch:open {
    background-color: #303030;
}

QTreeView#m_mainFileTreeView::branch:open:hover {
    background-color: #303030;
}

QTreeView#m_mainFileTreeView::branch:closed:has-children {
    background-color: #303030;
}

QTreeView#m_mainFileTreeView::branch:closed:has-children:hover {
    background-color: #303030;
}

QColumnView{
	background-color: #656565;
}

QHeaderView::section {
    color: #fff;
    background-color: #656565;
}

QTableWidget {
	color: #fff;
	alternate-background-color: #656565;
	background-color: #303030;
}

QTableWidget::item {
}

QWidget {
	color: white;
}

QMenuBar::item {
	color : #000000;
}
QMenu::item{
	padding: 5px 30px 5px 5px;
}
QMenu::item:selected {
	background-color: rgb(52,73,94);
	padding: 5px 30px 5px 8px;
}

QPushButton {
	background-color: #535353;
}
		
QPushButton:hover {
	background-color: #484848;
}

QPushButton:disabled{
	color: gray;
}

QLineEdit{
	background-color: #303030;
	border-style: outset;
	/*border: 1px solid #f5f5f5;*/
	/*border-radius: 4px;*/
	padding: 4px;
	/*border-color: #eeeeee;*/
}
QLineEdit:disabled{
	color: gray;
}

QLabel{
	border: 0px solid white;
}

QComboBox {
	background-color: #414141;
	border-style: outset;
	border: 1px solid #f5f5f5;
	border-radius: 4px;
	border-color:  #eeeeee;
	padding: 4px;
}

QDateEdit
{
	background-color: #414141;
	border-style: outset;
	border: 1px solid #f5f5f5;
	border-radius: 4px;
	border-color:  #eeeeee;
	padding: 4px;
}

QDateEdit:disabled{
	color: gray;
}

QDateTimeEdit
{
	background-color: #414141;
	border-style: outset;
	border: 1px solid #f5f5f5;
	border-radius: 4px;
	border-color:  #eeeeee;
	padding: 4px;
}

QDateTimeEdit:disabled{
	color: gray;
}

QScrollBar:vertical {
	border-radius: 2px;
	border-style: outset;
	background-color: #414141;
}

QScrollBar:horizontal {
	border-radius: 2px;
	background-color: #414141;
}

QSplitter::handle:horizontal {
	width : 1px;
	border-radius: 1px;
	background-color: #707070;
}

QSplitter::handle:vertical {
	height : 1px;
	border-radius: 1px;
	background-color: #707070;
}

QProgressBar {
    border-radius: 3px;
    border: 1px solid #969696;
    background-color: #506482;
    
    font-family: Arial;
    font-size: 15px;
    font-weight: normal;
    font-style: normal;
    line-height: 1.15;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
   background-color: #2382AE;
}

/* ================ Radio Button ==================*/
QRadioButton#m_rdoTab_Folder::indicator {
    image: url(:/Resource/Images/deepcatch/folder_d.png);
}

QRadioButton#m_rdoTab_Folder::indicator:hover {
    image: url(:/Resource/Images/deepcatch/folder_h.png);
}

QRadioButton#m_rdoTab_Folder::indicator:checked {
    image: url(:/Resource/Images/deepcatch/folder_p.png);
}

QRadioButton#m_rdoTab_PatientList::indicator {
    image: url(:/Resource/Images/deepcatch/patient_list_d.png);
}

QRadioButton#m_rdoTab_PatientList::indicator:hover {
    image: url(:/Resource/Images/deepcatch/patient_list_h.png);
}

QRadioButton#m_rdoTab_PatientList::indicator:checked {
    image: url(:/Resource/Images/deepcatch/patient_list_p.png);
}

QRadioButton#m_rdoTab_PACSDownload::indicator {
    image: url(:/Resource/Images/deepcatch/pacs_down_d.png);
}

QRadioButton#m_rdoTab_PACSDownload::indicator:hover {
    image: url(:/Resource/Images/deepcatch/pacs_down_h.png);
}

QRadioButton#m_rdoTab_PACSDownload::indicator:checked {
    image: url(:/Resource/Images/deepcatch/pacs_down_p.png);
}

QRadioButton#m_rdoTab_PACSUpload::indicator {
    image: url(:/Resource/Images/deepcatch/pacs_upload_d.png);
}

QRadioButton#m_rdoTab_PACSUpload::indicator:hover {
    image: url(:/Resource/Images/deepcatch/pacs_upload_h.png);
}

QRadioButton#m_rdoTab_PACSUpload::indicator:checked {
    image: url(:/Resource/Images/deepcatch/pacs_upload_p.png);
}
